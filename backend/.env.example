# ───────────────────────────────────────────────
# AntiGravity Backend — Environment Variables
# Copy this file to .env and fill in your keys
# ───────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/antigravity?retryWrites=true&w=majority

# ── External Data APIs ──────────────────────────
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
TOMTOM_API_KEY=your_tomtom_api_key

# ── Threat Intelligence ─────────────────────────
ABUSEIPDB_API_KEY=your_abuseipdb_api_key

# ── AI / Gemini ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── IPFS / Pinata ───────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key

# ── Blockchain / Polygon Amoy ──────────────────
# RPC endpoint (Alchemy, Infura, or local Hardhat)
RPC_URL=https://rpc-amoy.polygon.technology
# Private key of the signer wallet (NO 0x prefix)
PRIVATE_KEY=your_wallet_private_key
# Chain ID (80002 = Polygon Amoy testnet, 31337 = Hardhat)
CHAIN_ID=80002

# ── Contract Addresses (after deployment) ──────
# Fill these after running `npx hardhat run scripts/deploy.js`
CONTRACT_ANCHOR=
CONTRACT_TOKEN=
CONTRACT_FORENSICS=
